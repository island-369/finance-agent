# 复制为 .env 并填入真实值;.env 已被 .gitignore 排除,秘钥不入库
# 任何 OpenAI 兼容端点均可;示例为 DeepSeek
FINANCE_AGENT_MODEL_PROVIDER=openai
FINANCE_AGENT_MODEL=deepseek-flash
FINANCE_AGENT_BASE_URL=https://api.deepseek.com
# DeepSeek 思考模式不支持强制 tool_choice(结构化结果依赖它),默认关闭;
# 可选值 disabled / enabled
FINANCE_AGENT_THINKING=disabled
# 秘钥本身使用对应供应商的标准变量名
OPENAI_API_KEY=sk-your-key-here

# M0 实验参数
FINANCE_AGENT_M0_BUDGET_MODEL_CALLS=15
FINANCE_AGENT_M0_BUDGET_TOOL_CALLS=30
